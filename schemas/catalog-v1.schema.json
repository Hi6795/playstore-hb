{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playstorehb.invalid/schemas/catalog-v1.schema.json",
  "title": "Playstore HB Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_version", "catalog_sequence", "generated_at", "expires_at", "minimum_client_version", "key_id", "channel", "games"],
  "properties": {
    "schema_version": { "const": 1 },
    "catalog_version": { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]+$" },
    "catalog_sequence": { "type": "integer", "minimum": 0 },
    "generated_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "minimum_client_version": { "$ref": "#/$defs/semver" },
    "key_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "channel": { "enum": ["stable", "beta", "development"] },
    "games": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/game" } }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "https": { "type": "string", "format": "uri", "pattern": "^https://" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title_id", "content_id", "name", "developer", "publisher", "version", "release_date", "updated_at", "summary", "description", "distribution_mode", "requires_original_files", "original_files_notice", "categories", "tags", "players_min", "players_max", "local_multiplayer", "online_multiplayer", "internet_required", "package", "media", "compatibility", "legal", "changelog"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title_id": { "type": "string", "pattern": "^[A-Z]{4}[0-9]{5}$" },
        "content_id": { "type": "string", "pattern": "^[A-Z]{2}[0-9]{4}-[A-Z]{4}[0-9]{5}_00-[A-Z0-9]{16}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "developer": { "type": "string", "minLength": 1, "maxLength": 120 },
        "publisher": { "type": "string", "minLength": 1, "maxLength": 120 },
        "version": { "$ref": "#/$defs/semver" },
        "release_date": { "type": "string", "format": "date" },
        "updated_at": { "type": "string", "format": "date-time" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 240 },
        "description": { "type": "string", "minLength": 1, "maxLength": 12000 },
        "distribution_mode": { "enum": ["ready_to_play", "requires_original_files"] },
        "requires_original_files": { "type": "boolean" },
        "original_files_notice": { "type": ["string", "null"], "maxLength": 500 },
        "categories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["arcade", "community-releases", "horror", "local-multiplayer", "online-multiplayer", "platformers", "puzzle", "racing", "rhythm", "rpg", "shooters", "strategy"] } },
        "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } },
        "players_min": { "type": "integer", "minimum": 1, "maximum": 8 },
        "players_max": { "type": "integer", "minimum": 1, "maximum": 8 },
        "local_multiplayer": { "type": "boolean" },
        "online_multiplayer": { "type": "boolean" },
        "internet_required": { "type": "boolean" },
        "package": {
          "type": "object", "additionalProperties": false,
          "required": ["url", "size_bytes", "sha256", "filename"],
          "properties": { "url": { "$ref": "#/$defs/https" }, "size_bytes": { "type": "integer", "minimum": 1, "maximum": 107374182400 }, "sha256": { "$ref": "#/$defs/sha256" }, "filename": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,126}\\.pkg$" }, "etag": { "type": "string", "maxLength": 256 }, "expires_at": { "type": "string", "format": "date-time" } }
        },
        "media": {
          "type": "object", "additionalProperties": false, "required": ["cover", "background", "icon", "screenshots"],
          "properties": { "cover": { "$ref": "#/$defs/https" }, "background": { "$ref": "#/$defs/https" }, "icon": { "$ref": "#/$defs/https" }, "screenshots": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/https" } } }
        },
        "compatibility": {
          "type": "object", "additionalProperties": false, "required": ["status", "models", "firmware_reports", "notes"],
          "properties": { "status": { "enum": ["unverified", "partially_verified", "verified", "incompatible"] }, "models": { "type": "array", "uniqueItems": true, "items": { "enum": ["fat", "slim", "pro"] } }, "firmware_reports": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["firmware", "environment", "result", "tested_at"], "properties": { "firmware": { "type": "string" }, "environment": { "type": "string" }, "result": { "enum": ["pass", "fail"] }, "tested_at": { "type": "string", "format": "date-time" } } } }, "notes": { "type": "array", "items": { "type": "string" } } }
        },
        "legal": {
          "type": "object", "additionalProperties": false, "required": ["code_license", "data_license", "source_url", "redistribution_status", "redistribution_evidence_id", "attribution"],
          "properties": { "code_license": { "type": "string", "minLength": 1 }, "data_license": { "type": "string", "minLength": 1 }, "source_url": { "$ref": "#/$defs/https" }, "redistribution_status": { "enum": ["pending", "approved", "revoked"] }, "redistribution_evidence_id": { "type": "string", "minLength": 1 }, "attribution": { "type": "array", "items": { "type": "string" } } }
        },
        "controls": { "type": "array", "items": { "type": "string" } },
        "known_issues": { "type": "array", "items": { "type": "string" } },
        "changelog": { "type": "array", "items": { "type": "object", "required": ["version", "date", "changes"], "additionalProperties": false, "properties": { "version": { "$ref": "#/$defs/semver" }, "date": { "type": "string", "format": "date" }, "changes": { "type": "array", "items": { "type": "string" } } } } },
        "development_test_data": { "type": "boolean" }
      }
    }
  }
}
